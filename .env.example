GROQ_API_KEY=
OPENAI_API_KEY=

# Supabase pooler connection string (Transaction mode, port 6543) -- click "Connect" at
# the top of your Supabase project dashboard, not Settings -> Database (moved out of there).
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-[region].pooler.supabase.com:6543/postgres?sslmode=require

JWT_SECRET=
JWT_EXPIRE_MINUTES=30

# Shared secret header required by POST /internal/topic-tagging/run (called by the external cron).
INTERNAL_SHARED_SECRET=

# Cosine similarity floor for RAG retrieval. 0.3 was empirically calibrated against
# text-embedding-3-small (question-to-passage similarity runs much lower than the
# 0.7-0.75 you might expect) -- see comment in backend/app/core/config.py.
SIMILARITY_THRESHOLD=0.3
CORS_ORIGINS=["http://localhost:3000"]
