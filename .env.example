GROQ_API_KEY=
OPENAI_API_KEY=

# Supabase pooler connection string (port 6543), Settings -> Database in the Supabase dashboard.
DATABASE_URL=postgresql://postgres:[password]@[project-ref].pooler.supabase.com:6543/postgres?sslmode=require

JWT_SECRET=
JWT_EXPIRE_MINUTES=30

# Shared secret header required by POST /internal/topic-tagging/run (called by the external cron).
INTERNAL_SHARED_SECRET=

SIMILARITY_THRESHOLD=0.72
CORS_ORIGINS=["http://localhost:3000"]
